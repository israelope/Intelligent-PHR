# ---------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# .env.local is already excluded from version control (see .gitignore).
# ---------------------------------------------------------------

# From your Supabase project: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From your Anthropic account: https://console.anthropic.com/settings/keys
# (You can swap this for an OpenAI key instead - see lib/ai.js)
ANTHROPIC_API_KEY=sk-ant-your-key-here
